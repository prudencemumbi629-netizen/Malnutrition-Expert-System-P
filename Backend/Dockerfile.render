FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY schema.py server.py ./
ARG FYM_MODEL_SHA256
RUN --mount=type=secret,id=fym_model_url,required=true \
    --mount=type=bind,source=fetch_model.py,target=/tmp/fetch_model.py \
    python /tmp/fetch_model.py
USER 65532:65532
ENV HOST=0.0.0.0 PORT=8000 PYTHONDONTWRITEBYTECODE=1
EXPOSE 8000
CMD ["python", "server.py"]
