{
  "name": "project-fym-inference",
  "main": "./inference-worker.mjs",
  "compatibility_date": "2026-11-22",
  "containers": [
    {
      "class_name": "InferenceContainer",
      "image": "../Backend/Dockerfile",
      "image_build_context": "../Backend",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {"name": "INFERENCE", "class_name": "InferenceContainer"}
    ]
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["InferenceContainer"]}
  ]
}
